[%General]
author=Redmond2K
comment=Windows 2000 classic look. SVG generated by make-svg.py.
respect_DE=true
x11drag=none
alt_mnemonic=true
composite=false
animate_states=false
no_inactiveness=true
menu_shadow_depth=0
tooltip_shadow_depth=0
left_tabs=true
joined_inactive_tabs=false
attach_active_tab=true
active_tab_overlap=2
groupbox_top_label=false
scroll_width=16
scroll_min_extent=16
scroll_arrows=true
scrollbar_in_view=false
transient_scrollbar=false
check_size=13
menu_separator_height=9
submenu_overlap=0
splitter_width=4
slider_width=4
slider_handle_width=11
slider_handle_length=11
spin_button_width=16
tree_branch_line=false
fill_rubberband=false
small_icon_size=16
large_icon_size=32
button_icon_size=16

[GeneralColors]
window.color=#D4D0C8
base.color=#FFFFFF
alt.base.color=#FFFFFF
button.color=#D4D0C8
light.color=#FFFFFF
mid.light.color=#D4D0C8
dark.color=#7F7F7F
mid.color=#A9A6A0
shadow.color=#3F3F3F
highlight.color=#002468
inactive.highlight.color=#002468
tooltip.base.color=#FFFFE1
text.color=#000000
window.text.color=#000000
button.text.color=#000000
disabled.text.color=#A9A6A0
tooltip.text.color=#000000
highlight.text.color=#FFFFFF
link.color=#0000FF
link.visited.color=#800080
progress.indicator.text.color=#FFFFFF

[Hacks]
respect_darkness=false
normal_default_pushbutton=true

[PanelButtonCommand]
frame=true
frame.element=w-button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=w-button
indicator.element=w-arrow
indicator.size=8
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000
text.shadow=false
text.margin=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=8
text.margin.right=8
text.iconspacing=4

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=w-sbutton
interior.element=w-sbutton
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=3
text.margin.right=3

[ToolbarButton]
frame.element=w-tbutton
interior.element=w-tbutton
indicator.element=w-arrow
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=w-sbutton
interior.element=w-sbutton
indicator.element=w-spin
frame.top=2
frame.bottom=2
frame.left=0
frame.right=0
indicator.size=16

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=w-radio
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=w-check
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3

[Focus]
inherits=PanelButtonCommand
interior=false
frame=true
frame.element=w-focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=2

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=w-common
interior.element=w-common
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[LineEdit]
inherits=PanelButtonCommand
frame.element=w-lineedit
interior.element=w-lineedit
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2

[DropDownButton]
inherits=PanelButtonCommand
frame.element=w-sbutton
interior.element=w-sbutton
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=w-arrow-down

[IndicatorArrow]
indicator.element=w-arrow
indicator.size=8

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=w-tab
interior.element=w-tab
indicator.element=w-tab
frame.top=4
frame.bottom=0
frame.left=2
frame.right=2
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6

[TabFrame]
inherits=PanelButtonCommand
frame.element=w-tabframe
interior.element=w-tabframe
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=w-tree
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.element=w-sbutton
interior.element=w-sbutton
indicator.element=w-arrow
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=1
text.margin.bottom=1
text.margin.left=4
text.margin.right=4

[SizeGrip]
indicator.element=w-sizegrip
indicator.size=12

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=w-toolbar
indicator.element=w-toolbar
indicator.size=4
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[Slider]
inherits=PanelButtonCommand
frame.element=w-slider
interior.element=w-slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=w-slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=w-progress
interior.element=w-progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=#000000
text.focus.color=#000000

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior.element=w-progress-pattern
interior.x.patternsize=10

[ItemView]
inherits=PanelButtonCommand
frame=false
interior.element=w-itemview
text.margin=0
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
interior.element=w-splitter
indicator.element=w-splitter-grip

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=w-sarrow
indicator.size=16

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=w-thumb
interior.element=w-thumb
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=w-grip

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior.element=w-groove
interior.x.patternsize=2
interior.y.patternsize=2

[MenuItem]
inherits=PanelButtonCommand
frame=false
interior.element=w-menuitem
indicator.element=w-menuitem
text.normal.color=#000000
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=w-menubaritem
interior=false
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=5
text.margin.right=5
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#000000

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false

[ComboBox]
inherits=PanelButtonCommand
frame.element=w-lineedit
interior.element=w-lineedit
indicator.element=w-carrow
indicator.size=16
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=3
text.margin.right=3

[Menu]
inherits=PanelButtonCommand
frame.element=w-menu
interior.element=w-menu
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color=#000000

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=w-group
interior=false
text.margin=0
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ToolTip]
inherits=GenericFrame
frame.element=w-tooltip
interior=true
interior.element=w-tooltip
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin=0

[Window]
interior=false

[Dialog]
interior=false
